# ===================================
# 经销商返利对账系统 - 生产环境配置
# ===================================
# 
# 使用说明:
# 1. 复制此文件为 .env.production
# 2. 替换所有 <替换为xxx> 的占位符为实际值
# 3. 确保不要将包含真实密码的文件提交到Git

# ----------------------------------
# 数据库配置
# ----------------------------------
# 格式: mysql://用户名:密码@数据库地址:端口/数据库名
# 示例: mysql://root:MyPassword123@rm-xxxxx.mysql.rds.aliyuncs.com:3306/rebate_system
DATABASE_URL=mysql://<替换为数据库用户名>:<替换为数据库密码>@<替换为数据库内网地址>:3306/rebate_system

# ----------------------------------
# JWT密钥配置
# ----------------------------------
# 用于生成和验证JWT token的密钥
# 建议使用随机生成的复杂字符串(至少32位)
# 可访问 https://randomkeygen.com/ 生成
JWT_SECRET=<替换为随机生成的复杂字符串>

# ----------------------------------
# OAuth认证配置(如果使用Manus OAuth)
# ----------------------------------
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
VITE_APP_ID=<替换为您的Manus应用ID>

# ----------------------------------
# 应用基础配置
# ----------------------------------
VITE_APP_TITLE=经销商返利对账系统
VITE_APP_LOGO=/logo.png
NODE_ENV=production
PORT=3000

# ----------------------------------
# 管理员配置
# ----------------------------------
# 系统所有者的OpenID(登录后可在个人信息中查看)
OWNER_OPEN_ID=<替换为管理员的OpenID>
OWNER_NAME=<替换为管理员姓名>

# ----------------------------------
# 其他可选配置
# ----------------------------------
# 如果使用Manus内置API
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
# BUILT_IN_FORGE_API_KEY=<替换为您的API密钥>
# VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im
# VITE_FRONTEND_FORGE_API_KEY=<替换为前端API密钥>
