# ===================================
# Nginx反向代理配置 - 经销商返利对账系统
# ===================================
#
# 使用说明:
# 1. 将此文件复制到 /etc/nginx/sites-available/rebate_system
# 2. 替换 yourdomain.com 为您的实际域名(如果使用IP访问,改为 server_name _; )
# 3. 创建软链接: sudo ln -s /etc/nginx/sites-available/rebate_system /etc/nginx/sites-enabled/
# 4. 测试配置: sudo nginx -t
# 5. 重启Nginx: sudo systemctl restart nginx

server {
    listen 80;
    listen [::]:80;
    
    # 替换为您的域名,如果使用IP访问则改为: server_name _;
    server_name yourdomain.com www.yourdomain.com;
    
    # 访问日志和错误日志
    access_log /var/log/nginx/rebate_system_access.log;
    error_log /var/log/nginx/rebate_system_error.log;
    
    # 客户端上传文件大小限制(根据需要调整)
    client_max_body_size 10M;
    
    # 反向代理到Node.js应用
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        
        # WebSocket支持
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # 传递真实客户端信息
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 禁用缓存(开发阶段)
        proxy_cache_bypass $http_upgrade;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
    
    # 静态资源缓存(可选,提升性能)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://localhost:3000;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    
    # 健康检查端点(可选)
    location /health {
        proxy_pass http://localhost:3000/health;
        access_log off;
    }
}

# ===================================
# HTTPS配置(使用Certbot自动生成)
# ===================================
# 
# 申请SSL证书后,Certbot会自动在此文件中添加HTTPS配置
# 手动申请命令: sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com
